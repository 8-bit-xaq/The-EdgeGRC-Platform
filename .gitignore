# ==========================================
# Edge-GRC Appliance - Root .gitignore
# ==========================================

# Sensitive keys, credentials, and secrets
grc-backend/configs/vendor_private.pem
grc-backend/configs/django_secret.txt
grc-backend/configs/appliance_domain.txt
grc-backend/configs/ssl/appliance_key.pem
grc-backend/configs/ssl/appliance_cert.pem
**/INITIAL_ADMIN_PASSWORD
**/*_private.pem
**/*_key.pem

# Environment files
.env
.env.local
.env.*.local
*.env
!*.env.example

# SQLite Databases & runtime DB locks
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# Python
grc-backend/venv/
grc-backend/.venv/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Node / Frontend
grc-frontend/node_modules/
node_modules/
grc-frontend/.next/
.next/
grc-frontend/out/
grc-frontend/build/
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Appliance Runtime & Media
grc-backend/media/
grc-backend/logs/
grc-backend/staticfiles/
grc-backend/task_results/
grc-backend/updates/
grc-backend/backups/
*.log

# Packaging artifacts
payload.zip
update-*.zip
*.zip
signature.sig

# System & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

