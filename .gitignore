# ==========================================
# Edge-GRC Appliance - Root .gitignore
# ==========================================

# --- Next.js Frontend ---
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Django Backend ---
__pycache__/
*.py[cod]
*$py.class
venv/
env/
db.sqlite3
db.sqlite3-journal

# --- User Data & Uploads ---
# Ignores physical evidence proofs, avatars, and test plan attachments
media/

# --- Appliance Specifics ---
# Ignores downloaded system upgrade packages
updates/
# Ignores generated local X.509 HTTPS certificates
configs/ssl/*.pem

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example 

# --- IDE & OS Files ---
.vscode/
.DS_Store
Thumbs.db