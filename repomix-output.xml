import { Button } from "@/components/ui/button"
import { type ComplianceControl, type RemediationTask } from "@/lib/controls"
import { type RiskItem, getRiskLevel } from "@/lib/risks"
import { fetchApi } from "@/lib/api"
import { cn } from "@/lib/utils"

const chartConfig = {
  effective: { label: "Strong / Effective", color: "#22c55e" },
  deficient: { label: "Weak / Deficient", color: "#ef4444" },
  notTested: { label: "Not Yet Evaluated", color: "#94a3b8" },
  inherent: { label: "Inherent Risk", color: "#f87171" },
  residual: { label: "Residual Risk", color: "#3b82f6" }, 
} satisfies ChartConfig

interface MetricsDashboardProps {
  onControlClick?: (controlId: string) => void
  onStatusClick?: (status: "Passing" | "Failing" | "Awaiting Approval" | "All") => void
}

// --- NEW: Reusable Pagination Component for Dashboard Widgets ---
function DashboardPagination({ page, totalItems, onPageChange }: { page: number, totalItems: number, onPageChange: (p: number) => void }) {
  const pageSize = 5
  const totalPages = Math.max(1, Math.ceil(totalItems / pageSize))
  
  if (totalPages <= 1) return null
  
  return (
    <div className="flex items-center justify-between border-t border-border bg-muted/20 px-4 py-2.5 mt-auto">
      <span className="text-xs font-medium text-muted-foreground">
        Page {page} of {totalPages}
      </span>
      <div className="flex items-center gap-1.5">
        <Button
          variant="outline"
          size="xs"
          onClick={(e) => { e.stopPropagation(); onPageChange(page - 1) }}
          disabled={page === 1}
        >
          Prev
        </Button>
        <Button
          variant="outline"
          size="xs"
          onClick={(e) => { e.stopPropagation(); onPageChange(page + 1) }}
          disabled={page === totalPages}
        >
          Next
        </Button>
      </div>
    </div>
  )
}

export function MetricsDashboard({ onControlClick, onStatusClick }: MetricsDashboardProps) {
  const [controls, setControls] = useState<ComplianceControl[]>([])
  const [risks, setRisks] = useState<RiskItem[]>([])
  const [tasks, setTasks] = useState<RemediationTask[]>([])
  const [isLoading, setIsLoading] = useState(true)
  const [role, setRole] = useState("Contributor")

  // --- NEW: Pagination States for each widget ---
  const [vulnPage, setVulnPage] = useState(1)
  const [auditInboxPage, setAuditInboxPage] = useState(1)
  const [qaInboxPage, setQaInboxPage] = useState(1)
  const [tasksPage, setTasksPage] = useState(1)
  const [failuresPage, setFailuresPage] = useState(1)
  const [upcomingPage, setUpcomingPage] = useState(1)

  useEffect(() => {
    const savedRole = localStorage.getItem("grc_role") || sessionStorage.getItem("grc_role") || "Contributor"
    setRole(savedRole)

    // Using the centralized fetchApi to handle URLs and Auth Tokens
    Promise.all([
      fetchApi("controls/"),
      fetchApi("risks/"),
      fetchApi("tasks/")
    ])
      .then(async ([ctrlRes, riskRes, taskRes]) => {
        if (ctrlRes.ok) {
          const cData = await ctrlRes.json()
          setControls(cData.map((item: any) => ({ ...item, id: item.control_id })))
        }
        if (riskRes.ok) {
          const rData = await riskRes.json()
          setRisks(rData)
        }
        if (taskRes.ok) {
          const tData = await taskRes.json()
          setTasks(tData)
        }
        setIsLoading(false)
      })
      .catch((err) => {
        console.error("Failed to fetch dashboard data:", err)
        setIsLoading(false)
      })
  }, [])

  // RBAC Visibility Flags
  const showRisk = role === "Admin" || role === "Executive"
  const showHealth = role === "Admin" || role === "Executive" || role === "Auditor"
  const showQA = role === "Admin" || role === "Reviewer"
  const showAuditInbox = role === "Admin" || role === "Auditor" || role === "Executive"

  const metrics = useMemo(() => {
    const total = controls.length
    const passing = controls.filter((c) => c.status === "Passing").length
    const notApplicable = controls.filter((c) => c.status === "Not Applicable").length
    
    const evaluatableTotal = total - notApplicable
    const score = evaluatableTotal === 0 ? 0 : Math.round((passing / evaluatableTotal) * 100)
    
    const designEffective = controls.filter((c) => c.control_effectiveness === "Effective").length
    const designDeficient = controls.filter((c) => c.control_effectiveness === "Deficient").length
    const designNotTested = controls.filter((c) => c.control_effectiveness === "Not Tested" || !c.control_effectiveness).length

    const operatingEffective = controls.filter((c) => c.implementation_effectiveness === "Effective").length
    const operatingDeficient = controls.filter((c) => c.implementation_effectiveness === "Deficient").length
    const operatingNotTested = controls.filter((c) => c.implementation_effectiveness === "Not Tested" || !c.implementation_effectiveness).length
    
    // Removed the slice(0,5) to allow pagination
    const recentFailures = controls.filter((c) => c.status === "Failing")

    const totalInherent = risks.reduce((acc, curr) => acc + curr.inherent_score, 0)
    const totalResidual = risks.reduce((acc, curr) => acc + curr.residual_score, 0)
    const riskMitigatedPercent = totalInherent === 0 ? 0 : Math.round(((totalInherent - totalResidual) / totalInherent) * 100)

    // Removed the slice(0,5) to allow pagination
    const topVulnerabilities = [...risks].sort((a, b) => b.residual_score - a.residual_score)
    
    // Removed the slice(0,5) to allow pagination
    const openTasks = tasks.filter(t => t.status !== "Resolved")

    const pendingQA = controls.flatMap((c) => 
      (c.assessments || [])
        .filter((a) => a.status === "In QA Review")
        .map((a) => ({ ...a, control_id: c.id }))
    ).sort((a, b) => new Date(b.date_started).getTime() - new Date(a.date_started).getTime())
    
    const readyForAudit = controls.filter((c) => c.status === "Ready for Audit")

    const upcomingAudits = controls
      .filter((c) => c.testing_frequency && c.testing_frequency !== "None" && c.next_audit_date)
      .sort((a, b) => new Date(a.next_audit_date!).getTime() - new Date(b.next_audit_date!).getTime())

    return { 
      total, passing, notApplicable, score, 
      designEffective, designDeficient, designNotTested,
      operatingEffective, operatingDeficient, operatingNotTested,
      recentFailures,
      totalInherent, totalResidual, riskMitigatedPercent, topVulnerabilities,
      openTasks, pendingQA, readyForAudit, upcomingAudits
    }
  }, [controls, risks, tasks])

  const designData = useMemo(() => [
    { key: "deficient", label: "Flawed Policy", value: metrics.designDeficient, fill: chartConfig.deficient.color },
    { key: "effective", label: "Sound Policy", value: metrics.designEffective, fill: chartConfig.effective.color },
    { key: "notTested", label: "Unassessed", value: metrics.designNotTested, fill: chartConfig.notTested.color },
  ].filter(d => d.value > 0), [metrics])

  const operatingData = useMemo(() => [
    { key: "deficient", label: "Execution Failure", value: metrics.operatingDeficient, fill: chartConfig.deficient.color },
    { key: "effective", label: "Consistently Followed", value: metrics.operatingEffective, fill: chartConfig.effective.color },
    { key: "notTested", label: "Unassessed", value: metrics.operatingNotTested, fill: chartConfig.notTested.color },
  ].filter(d => d.value > 0), [metrics])

  const roiData = useMemo(() => [
    { 
      name: "Risk Exposure", 
      inherent: metrics.totalInherent, 
      residual: metrics.totalResidual 
    }
  ], [metrics])

  if (isLoading) {
    return (
      <section className="flex w-full items-center justify-center py-24 text-muted-foreground">
        <Loader2 className="mr-2 size-6 animate-spin" aria-hidden />
        Loading dashboard metrics...
      </section>
    )
  }

  return (
    <section className="w-full space-y-4">
      <div className="flex flex-col gap-1">
        <h2 className="text-xl font-semibold tracking-tight text-balance">Executive Dashboard</h2>
        <p className="text-sm text-muted-foreground text-pretty">
          Real-time visibility into compliance health and active business risks.
        </p>
      </div>

      {/* Top Scores Row */}
      <div className={cn("grid gap-4", showRisk ? "md:grid-cols-2" : "grid-cols-1")}>
        <Card className="overflow-hidden border-success/20">
          <CardContent className="flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center">
            <div className="flex size-12 shrink-0 items-center justify-center rounded-full bg-success/10 text-success">
              <ShieldCheck className="size-6" aria-hidden />
            </div>
            <div className="flex flex-col gap-1">
              <CardDescription className="text-sm font-medium">Compliance Coverage</CardDescription>
              <div className="flex items-baseline gap-2">
                <span className="text-4xl font-bold tracking-tight tabular-nums">{metrics.score}%</span>
                {metrics.total > 0 && (
                  <span className="inline-flex items-center gap-1 text-sm font-medium text-success">
                    <TrendingUp className="size-4" aria-hidden />
                    {metrics.passing} / {metrics.total - metrics.notApplicable} Controls Passing
                  </span>
                )}
              </div>
            </div>
          </CardContent>
        </Card>

        {showRisk && (
          <Card className="overflow-hidden border-blue-500/20">
            <CardContent className="flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center">
              <div className="flex size-12 shrink-0 items-center justify-center rounded-full bg-blue-500/10 text-blue-500">
                <Target className="size-6" aria-hidden />
              </div>
              <div className="flex flex-col gap-1">
                <CardDescription className="text-sm font-medium">Total Risk Mitigated</CardDescription>
                <div className="flex items-baseline gap-2">
                  <span className="text-4xl font-bold tracking-tight tabular-nums">{metrics.riskMitigatedPercent}%</span>
                  {risks.length > 0 && (
                    <span className="inline-flex items-center gap-1 text-sm font-medium text-blue-500">
                      <TrendingUp className="size-4" aria-hidden />
                      {metrics.totalInherent - metrics.totalResidual} pts reduced
                    </span>
                  )}
                  </div>
              </div>
            </CardContent>
          </Card>
        )}
      </div>

      {/* Health & ROI Charts Row */}
      {(showHealth || showRisk) && (
        <div className={cn("grid gap-4", showHealth && showRisk ? "md:grid-cols-3" : showHealth ? "md:grid-cols-2" : "md:grid-cols-1")}>
          {showHealth && (
            <>
              <Card className="flex flex-col">
                <CardHeader className="items-center pb-0 text-center">
                  <CardTitle className="text-base">Design Health</CardTitle>
                  <CardDescription className="text-xs">Policy Documentation</CardDescription>
                </CardHeader>
                <CardContent className="flex-1 pb-4">
                  <ChartContainer config={chartConfig} className="mx-auto aspect-square max-h-[200px]">
                    <PieChart>
                      <ChartTooltip cursor={false} content={<ChartTooltipContent hideLabel />} />
                      <Pie data={designData} dataKey="value" nameKey="label" innerRadius={55} strokeWidth={4}>
                        <Label
                          content={({ viewBox }) => {
                            if (viewBox && "cx" in viewBox && "cy" in viewBox) {
                              return (
                                <text x={viewBox.cx} y={viewBox.cy} textAnchor="middle" dominantBaseline="middle">
                                  <tspan x={viewBox.cx} y={viewBox.cy} className="fill-destructive text-2xl font-bold">
                                    {metrics.designDeficient}
                                  </tspan>
                                  <tspan x={viewBox.cx} y={(viewBox.cy || 0) + 16} className="fill-muted-foreground text-[10px]">
                                    Flaws
                                  </tspan>
                                </text>
                              )
                            }
                          }}
                        />
                      </Pie>
                    </PieChart>
                  </ChartContainer>
                </CardContent>
              </Card>

              <Card className="flex flex-col">
                <CardHeader className="items-center pb-0 text-center">
                  <CardTitle className="text-base">Operational Health</CardTitle>
                  <CardDescription className="text-xs">Execution & Evidence</CardDescription>
                </CardHeader>
                <CardContent className="flex-1 pb-4">
                  <ChartContainer config={chartConfig} className="mx-auto aspect-square max-h-[200px]">
                    <PieChart>
                      <ChartTooltip cursor={false} content={<ChartTooltipContent hideLabel />} />
                      <Pie data={operatingData} dataKey="value" nameKey="label" innerRadius={55} strokeWidth={4}>
                        <Label
                          content={({ viewBox }) => {
                            if (viewBox && "cx" in viewBox && "cy" in viewBox) {
                              return (
                                <text x={viewBox.cx} y={viewBox.cy} textAnchor="middle" dominantBaseline="middle">
                                  <tspan x={viewBox.cx} y={viewBox.cy} className="fill-destructive text-2xl font-bold">
                                    {metrics.operatingDeficient}
                                  </tspan>
                                  <tspan x={viewBox.cx} y={(viewBox.cy || 0) + 16} className="fill-muted-foreground text-[10px]">
                                    Failures
                                  </tspan>
                                </text>
                              )
                            }
                          }}
                        />
                      </Pie>
                    </PieChart>
                  </ChartContainer>
                </CardContent>
              </Card>
            </>
          )}

          {showRisk && (
            <Card className="flex flex-col">
              <CardHeader className="items-center pb-2 text-center">
                <CardTitle className="text-base">Control ROI</CardTitle>
                <CardDescription className="text-xs">Inherent vs. Residual Score</CardDescription>
              </CardHeader>
              <CardContent className="flex-1 px-2 pb-4">
                <ChartContainer config={chartConfig} className="mx-auto w-full max-h-[190px] mt-4">
                  <BarChart data={roiData} margin={{ top: 0, right: 0, left: -20, bottom: 0 }}>
                    <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="hsl(var(--border))" />
                    <XAxis dataKey="name" hide />
                    <YAxis tickLine={false} axisLine={false} tick={{ fontSize: 10, fill: "hsl(var(--muted-foreground))" }} />
                    <ChartTooltip cursor={{ fill: "transparent" }} content={<ChartTooltipContent />} />
                    <Legend verticalAlign="bottom" height={20} iconType="circle" wrapperStyle={{ fontSize: '10px' }} />
                    <Bar dataKey="inherent" fill="var(--color-inherent)" radius={[4, 4, 0, 0]} maxBarSize={40} />
                    <Bar dataKey="residual" fill="var(--color-residual)" radius={[4, 4, 0, 0]} maxBarSize={40} />
                  </BarChart>
                </ChartContainer>
              </CardContent>
            </Card>
          )}
        </div>
      )}

      {/* Risk Matrix Row */}
      {showRisk && (
        <div className="grid gap-4 md:grid-cols-2">
          <Card>
            <CardHeader>
              <CardTitle className="text-base">Inherent Risk Matrix</CardTitle>
              <CardDescription className="text-xs">Current threat landscape before mitigations.</CardDescription>
            </CardHeader>
            <CardContent className="flex justify-center pb-6">
              <div className="flex gap-2 items-center">
                <div className="text-[10px] uppercase font-bold text-muted-foreground tracking-widest" style={{ writingMode: 'vertical-rl', transform: 'rotate(180deg)' }}>
                  Likelihood
                </div>
                <div>
                  <div className="grid grid-cols-5 gap-1 bg-muted/20 p-1 border border-border rounded-md">
                    {[5, 4, 3, 2, 1].map((likelihood) => (
                      [1, 2, 3, 4, 5].map((impact) => {
                        const score = likelihood * impact;
                        const count = risks.filter(r => r.inherent_likelihood === likelihood && r.inherent_impact === impact).length;
                        
                        let bgColor = "bg-success/20 text-success-foreground"
                        if (score >= 15) bgColor = "bg-destructive text-destructive-foreground shadow-sm"
                        else if (score >= 10) bgColor = "bg-orange-500 text-white shadow-sm"
                        else if (score >= 5) bgColor = "bg-yellow-400 text-yellow-950"

                        return (
                          <div 
                            key={`${likelihood}-${impact}`} 
                            className={cn(
                              "flex items-center justify-center size-10 sm:size-12 rounded-sm text-sm font-bold transition-all",
                              bgColor,
                              count === 0 && "opacity-30 !bg-muted !text-transparent shadow-none"
                            )}
                            title={`Likelihood: ${likelihood}, Impact: ${impact} | Risks: ${count}`}
                          >
                            {count > 0 ? count : ""}
                          </div>
                        )
                      })
                    ))}
                  </div>
                  <div className="text-center mt-2 text-[10px] uppercase font-bold text-muted-foreground tracking-widest">
                    Impact
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>

          <Card className="flex flex-col">
            <CardHeader>
               <CardTitle className="text-base flex items-center gap-2">
                  <AlertTriangle className="size-4 text-destructive" />
                  Top Vulnerabilities
               </CardTitle>
               <CardDescription className="text-xs">Highest remaining residual risks.</CardDescription>
            </CardHeader>
            <CardContent className="flex-1">
               {metrics.topVulnerabilities.length === 0 ? (
                  <p className="py-8 text-center text-sm text-muted-foreground">No active risks mapped.</p>
               ) : (
                  <ul className="flex flex-col gap-3">
                     {metrics.topVulnerabilities.slice((vulnPage - 1) * 5, vulnPage * 5).map((risk) => {
                        const resLevel = getRiskLevel(risk.residual_score)
                        return (
                           <li key={risk.id} className="flex items-center justify-between border-b border-border pb-3 last:border-0 last:pb-0">
                              <div className="min-w-0 pr-4">
                                 <p className="text-sm font-medium text-foreground truncate">{risk.title}</p>
                                 <p className="text-xs text-muted-foreground font-mono mt-0.5">{risk.risk_id}</p>
                              </div>
                              <Badge variant="outline" className={cn("shrink-0 whitespace-nowrap", resLevel.badge)}>
                                 {resLevel.label} ({risk.residual_score})
                              </Badge>
                           </li>
                        )
                     })}
                  </ul>
               )}
            </CardContent>
            <DashboardPagination page={vulnPage} totalItems={metrics.topVulnerabilities.length} onPageChange={setVulnPage} />
          </Card>
        </div>
      )}

      {/* Action Inboxes Row */}
      <div className={cn("grid gap-4", 
        (showQA && showAuditInbox) ? "lg:grid-cols-3 md:grid-cols-2" : 
        (showQA || showAuditInbox) ? "md:grid-cols-2" : 
        "grid-cols-1"
      )}>
        
        {/* Audit Inbox (For Auditors / Admins / Executives) */}
        {showAuditInbox && (
          <Card className="flex flex-col">
            <CardHeader>
               <CardTitle className="text-base flex items-center gap-2">
                  <ClipboardList className="size-4 text-blue-500" />
                  Audit Inbox
               </CardTitle>
               <CardDescription className="text-xs">Controls submitted and ready for evaluation.</CardDescription>
            </CardHeader>
            <CardContent className="flex-1">
               {metrics.readyForAudit.length === 0 ? (
                  <p className="py-8 text-center text-sm text-muted-foreground">No controls waiting for audit.</p>
               ) : (
                  <ul className="flex flex-col gap-3">
                     {metrics.readyForAudit.slice((auditInboxPage - 1) * 5, auditInboxPage * 5).map((c) => (
                       <li 
                         key={c.id} 
                         className="flex flex-col justify-center border-b border-border pb-3 last:border-0 last:pb-0 cursor-pointer hover:bg-muted/50 rounded-md p-2 -mx-2 transition-colors"
                         onClick={() => onControlClick?.(c.id)}
                       >
                         <div className="flex justify-between items-start gap-2">
                           <p className="text-sm font-medium text-foreground truncate">{c.id}</p>
                           <Badge variant="outline" className="bg-blue-500/10 text-blue-600 border-transparent dark:text-blue-400">
                             Ready for Audit
                           </Badge>
                         </div>
                         <p className="text-xs text-muted-foreground line-clamp-1 mt-0.5">{c.description}</p>
                       </li>
                     ))}
                  </ul>
               )}
            </CardContent>
            <DashboardPagination page={auditInboxPage} totalItems={metrics.readyForAudit.length} onPageChange={setAuditInboxPage} />
          </Card>
        )}

        {/* Existing: QA Review Inbox (For Reviewers / Admins) */}
        {showQA && (
          <Card className="flex flex-col">
            <CardHeader>
               <CardTitle className="text-base flex items-center gap-2">
                  <ClipboardCheck className="size-4 text-amber-500" />
                  QA Review Inbox
               </CardTitle>
               <CardDescription className="text-xs">Assessments pending reviewer sign-off.</CardDescription>
            </CardHeader>
            <CardContent className="flex-1">
               {metrics.pendingQA.length === 0 ? (
                  <p className="py-8 text-center text-sm text-muted-foreground">No assessments pending QA review.</p>
               ) : (
                  <ul className="flex flex-col gap-3">
                     {metrics.pendingQA.slice((qaInboxPage - 1) * 5, qaInboxPage * 5).map((qa) => (
                       <li 
                         key={qa.id} 
                         className="flex flex-col justify-center border-b border-border pb-3 last:border-0 last:pb-0 cursor-pointer hover:bg-muted/50 rounded-md p-2 -mx-2 transition-colors"
                         onClick={() => onControlClick?.(qa.control_id)}
                       >
                         <div className="flex justify-between items-start gap-2">
                           <p className="text-sm font-medium text-foreground truncate">{qa.control_id} Assessment</p>
                           <Badge variant="outline" className="bg-amber-500/10 text-amber-500 border-transparent">
                             {qa.status}
                           </Badge>
                         </div>
                         <p className="text-xs text-muted-foreground font-mono mt-0.5">Assessor: {qa.assessor_username}</p>
                       </li>
                     ))}
                  </ul>
               )}
            </CardContent>
            <DashboardPagination page={qaInboxPage} totalItems={metrics.pendingQA.length} onPageChange={setQaInboxPage} />
          </Card>
        )}

        {/* Existing: Open Action Items (For Everyone) */}
        <Card className="flex flex-col">
          <CardHeader>
             <CardTitle className="text-base flex items-center gap-2">
                <ListTodo className="size-4 text-primary" />
                Open Action Items
             </CardTitle>
             <CardDescription className="text-xs">Your organization's pending POA&M tasks.</CardDescription>
          </CardHeader>
          <CardContent className="flex-1">
             {metrics.openTasks.length === 0 ? (
                <p className="py-8 text-center text-sm text-muted-foreground">No active remediation tasks right now.</p>
             ) : (
                <ul className="flex flex-col gap-3">
                   {metrics.openTasks.slice((tasksPage - 1) * 5, tasksPage * 5).map((task) => (
                     <li 
                       key={task.id} 
                       className="flex flex-col justify-center border-b border-border pb-3 last:border-0 last:pb-0 cursor-pointer hover:bg-muted/50 rounded-md p-2 -mx-2 transition-colors"
                       onClick={() => onControlClick?.(task.control)}
                     >
                       <div className="flex justify-between items-start gap-2">
                         <p className="text-sm font-medium text-foreground truncate">{task.title}</p>
                         <Badge variant="outline" className={cn(
                           "border-transparent",
                           task.status === "In Progress" ? "bg-amber-500/10 text-amber-500" : "bg-muted text-muted-foreground"
                         )}>
                           {task.status}
                         </Badge>
                       </div>
                       <p className="text-xs text-muted-foreground font-mono mt-0.5">Target: {task.control}</p>
                     </li>
                   ))}
                </ul>
             )}
          </CardContent>
          <DashboardPagination page={tasksPage} totalItems={metrics.openTasks.length} onPageChange={setTasksPage} />
        </Card>
      </div>

      {/* Remediation Plan & Upcoming Audits Row */}
      <div className="grid gap-4 md:grid-cols-2">
        <Card className="flex flex-col">
          <CardHeader>
            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
              <div>
                <CardTitle className="flex items-center gap-2 text-base">
                  <ShieldCheck className="size-4 text-primary" aria-hidden />
                  Control Remediation Plan
                </CardTitle>
                <CardDescription className="text-xs">Controls exhibiting active weaknesses.</CardDescription>
              </div>
            </div>
          </CardHeader>
          <CardContent className="flex-1">
            {metrics.recentFailures.length === 0 ? (
              <p className="py-6 text-center text-sm text-muted-foreground">
                No weaknesses or failing controls detected. Your framework is operating smoothly.
              </p>
            ) : (
              <ul className="flex flex-col divide-y">
                {metrics.recentFailures.slice((failuresPage - 1) * 5, failuresPage * 5).map((control) => (
                  <li 
                    key={control.id} 
                    onClick={() => onControlClick?.(control.id)}
                    className="flex flex-col gap-1 py-4 first:pt-0 last:pb-0 cursor-pointer transition-colors hover:bg-muted/30 rounded-md px-2"
                  >
                    <div className="flex items-start gap-3">
                      <span className="mt-0.5 shrink-0 rounded-md bg-destructive/10 px-2 py-1 font-mono text-xs font-medium text-destructive">
                        {control.id}
                      </span>
                      <p className="flex-1 text-sm text-pretty text-muted-foreground line-clamp-2">
                        {control.description}
                      </p>
                    </div>
                    <div className="ml-16 flex flex-wrap gap-2 text-[10px] uppercase font-semibold mt-1">
                       {control.control_effectiveness === "Deficient" && (
                         <span className="text-destructive bg-destructive/10 px-2 py-0.5 rounded border border-destructive/20">
                           Flawed Policy (Design Weakness)
                         </span>
                       )}
                       {control.implementation_effectiveness === "Deficient" && (
                         <span className="text-destructive bg-destructive/10 px-2 py-0.5 rounded border border-destructive/20">
                           Failed Execution (Operational Weakness)
                         </span>
                       )}
                       {control.control_effectiveness !== "Deficient" && control.implementation_effectiveness !== "Deficient" && (
                         <span className="text-muted-foreground bg-muted px-2 py-0.5 rounded border border-border">
                           General Control Failure
                         </span>
                       )}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </CardContent>
          <DashboardPagination page={failuresPage} totalItems={metrics.recentFailures.length} onPageChange={setFailuresPage} />
        </Card>

        {/* --- NEW: Upcoming Scheduled Audits Card --- */}
        <Card className="flex flex-col">
          <CardHeader>
            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
              <div>
                <CardTitle className="flex items-center gap-2 text-base">
                  <CalendarClock className="size-4 text-purple-500" aria-hidden />
                  Upcoming Scheduled Audits
                </CardTitle>
                <CardDescription className="text-xs">Controls approaching their automated re-evaluation date.</CardDescription>
              </div>
            </div>
          </CardHeader>
          <CardContent className="flex-1">
            {metrics.upcomingAudits.length === 0 ? (
              <p className="py-6 text-center text-sm text-muted-foreground">
                No scheduled audits are currently on the calendar.
              </p>
            ) : (
              <ul className="flex flex-col divide-y">
                {metrics.upcomingAudits.slice((upcomingPage - 1) * 5, upcomingPage * 5).map((control) => {
                  const auditDate = new Date(control.next_audit_date + "T12:00:00Z")
                  const reqDate = new Date(auditDate)
                  reqDate.setDate(reqDate.getDate() - 30)

                  return (
                    <li 
                      key={control.id} 
                      onClick={() => onControlClick?.(control.id)}
                      className="flex flex-col gap-1 py-4 first:pt-0 last:pb-0 cursor-pointer transition-colors hover:bg-muted/30 rounded-md px-2"
                    >
                      <div className="flex items-start justify-between gap-3">
                        <div className="flex items-center gap-2">
                          <span className="shrink-0 rounded-md bg-purple-500/10 px-2 py-1 font-mono text-xs font-medium text-purple-600 dark:text-purple-400">
                            {control.id}
                          </span>
                          <Badge variant="outline" className="text-[10px] bg-background">
                            {control.testing_frequency}
                          </Badge>
                        </div>
                        <span className="text-xs font-semibold text-foreground whitespace-nowrap">
                          Due: {auditDate.toLocaleDateString()}
                        </span>
                      </div>
                      <div className="flex items-center gap-2 text-xs text-muted-foreground mt-1">
                         <span className="truncate">Evidence opens on {reqDate.toLocaleDateString()}</span>
                      </div>
                    </li>
                  )
                })}
              </ul>
            )}
          </CardContent>
          <DashboardPagination page={upcomingPage} totalItems={metrics.upcomingAudits.length} onPageChange={setUpcomingPage} />
        </Card>
      </div>
    </section>
  )
}
</file>

<file path="grc-frontend/components/notification-bell.tsx">
"use client"

import { useState } from "react"
import { Bell, Check, CheckCheck, Info, ShieldAlert, TriangleAlert, X } from "lucide-react"
import { Button } from "@/components/ui/button"
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover"
import { cn } from "@/lib/utils"
import {
  formatRelativeTime,
  useNotifications,
  type NotificationSeverity,
} from "@/lib/notifications"

const SEVERITY_META: Record<
  NotificationSeverity,
  { icon: React.ComponentType<{ className?: string }>; className: string }
> = {
  info: { icon: Info, className: "text-primary bg-primary/10" },
  success: { icon: Check, className: "text-success bg-success/10" },
  warning: { icon: TriangleAlert, className: "text-chart-3 bg-chart-3/10" },
  critical: { icon: ShieldAlert, className: "text-destructive bg-destructive/10" },
}

// --- NEW: Added click handler prop ---
interface NotificationBellProps {
  onNotificationClick?: (controlId: string) => void
}

export function NotificationBell({ onNotificationClick }: NotificationBellProps) {
  const { notifications, unreadCount, markAsRead, markAllAsRead, removeNotification, clearAll } = useNotifications()
  
  // Track open state so we can close it when a user clicks a notification
  const [isOpen, setIsOpen] = useState(false)

  return (
    <Popover open={isOpen} onOpenChange={setIsOpen}>
      <PopoverTrigger
        render={
          <Button variant="outline" size="icon" className="relative" aria-label="Notifications" />
        }
      >
        <Bell className="size-5" aria-hidden />
        {unreadCount > 0 && (
          <span
            className="absolute -right-1 -top-1 flex size-4.5 min-w-[1.125rem] items-center justify-center rounded-full bg-destructive px-1 text-[10px] font-semibold leading-none text-destructive-foreground"
            aria-hidden
          >
            {unreadCount > 9 ? "9+" : unreadCount}
          </span>
        )}
        <span className="sr-only">
          {unreadCount > 0 ? `${unreadCount} unread notifications` : "No unread notifications"}
        </span>
      </PopoverTrigger>

      <PopoverContent
        align="end"
        sideOffset={8}
        className="w-[calc(100vw-2rem)] max-w-sm gap-0 p-0"
      >
        <div className="flex items-center justify-between gap-2 border-b border-border px-4 py-3">
          <div className="flex items-center gap-2">
            <h2 className="text-sm font-semibold text-popover-foreground">Notifications</h2>
            {unreadCount > 0 && (
              <span className="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                {unreadCount} new
              </span>
            )}
          </div>
          {unreadCount > 0 && (
            <button
              type="button"
              onClick={markAllAsRead}
              className="inline-flex items-center gap-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              <CheckCheck className="size-3.5" aria-hidden />
              Mark all read
            </button>
          )}
        </div>

        {notifications.length === 0 ? (
          <div className="flex flex-col items-center justify-center gap-2 px-4 py-12 text-center">
            <div className="flex size-11 items-center justify-center rounded-full bg-muted text-muted-foreground">
              <Bell className="size-5" aria-hidden />
            </div>
            <p className="text-sm font-medium text-popover-foreground">You&apos;re all caught up</p>
            <p className="text-xs text-muted-foreground">New alerts will appear here.</p>
          </div>
        ) : (
          <>
            <ul className="max-h-[22rem] overflow-y-auto">
              {notifications.map((n: any) => {
                const meta = SEVERITY_META[n.severity as NotificationSeverity] || SEVERITY_META.info
                const Icon = meta.icon
                return (
                  <li
                    key={n.id}
                    onClick={() => {
                      if (!n.read) markAsRead(n.id)
                      // --- NEW: Trigger navigation if the notification is linked to a control ---
                      if (n.target_control_id && onNotificationClick) {
                        onNotificationClick(n.target_control_id)
                        setIsOpen(false)
                      }
                    }}
                    className={cn(
                      "group relative flex gap-3 border-b border-border px-4 py-3 last:border-b-0 transition-colors",
                      !n.read && "bg-accent/40",
                      n.target_control_id && "cursor-pointer hover:bg-muted/50"
                    )}
                  >
                    <span
                      className={cn(
                        "mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full",
                        meta.className,
                      )}
                    >
                      <Icon className="size-4" aria-hidden />
                    </span>
                    <div className="min-w-0 flex-1">
                      <div className="flex items-start justify-between gap-2">
                        <p className="text-sm font-medium text-popover-foreground text-pretty">
                          {n.title}
                        </p>
                        <button
                          type="button"
                          onClick={(e) => {
                            e.stopPropagation() // Prevent clicking the dismiss button from opening the modal
                            removeNotification(n.id)
                          }}
                          className="shrink-0 rounded p-0.5 text-muted-foreground opacity-0 transition-opacity hover:text-foreground focus-visible:opacity-100 group-hover:opacity-100"
                          aria-label={`Dismiss ${n.title}`}
                        >
                          <X className="size-3.5" aria-hidden />
                        </button>
                      </div>
                      <p className="mt-0.5 text-xs text-muted-foreground text-pretty">
                        {n.description}
                      </p>
                      <div className="mt-1.5 flex items-center gap-3">
                        <span className="text-xs text-muted-foreground">
                          {formatRelativeTime(n.timestamp)}
                        </span>
                        {!n.read && (
                          <button
                            type="button"
                            onClick={(e) => {
                              e.stopPropagation() // Prevent marking as read from opening the modal
                              markAsRead(n.id)
                            }}
                            className="text-xs font-medium text-primary transition-colors hover:text-primary/80"
                          >
                            Mark read
                          </button>
                        )}
                      </div>
                    </div>
                    {!n.read && (
                      <span
                        className="absolute right-2 top-1/2 size-1.5 -translate-y-1/2 rounded-full bg-primary"
                        aria-hidden
                      />
                    )}
                  </li>
                )
              })}
            </ul>
            <div className="border-t border-border p-2">
              <button
                type="button"
                onClick={clearAll}
                className="w-full rounded-md px-3 py-2 text-center text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
              >
                Clear all notifications
              </button>
            </div>
          </>
        )}
      </PopoverContent>
    </Popover>
  )
}
</file>

<file path="grc-frontend/components/onboarding-wizard.tsx">
"use client"

import { useEffect, useRef, useState } from "react"
import { Building2, Upload, ArrowRight, ShieldCheck, CheckCircle2, ChevronRight, LockKeyhole } from "lucide-react"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card"
import { useOrganization } from "@/lib/organization"
import { FrameworkUploader } from "@/components/framework-uploader"
import { toast } from "sonner"

interface OnboardingWizardProps {
  onComplete: () => void
}

export function OnboardingWizard({ onComplete }: OnboardingWizardProps) {
  const { organization, updateOrganization } = useOrganization()
  const [step, setStep] = useState(1)
  
  // Security State
  const [userId, setUserId] = useState<string | null>(null)
  const [newPassword, setNewPassword] = useState("")
  const [confirmPassword, setConfirmPassword] = useState("")
  const [isUpdatingPassword, setIsUpdatingPassword] = useState(false)

  // Organization State (Starts completely empty)
  const [companyName, setCompanyName] = useState("")
  const [workspaceName, setWorkspaceName] = useState("")
  const [logoDataUrl, setLogoDataUrl] = useState<string | null>(null)
  
  const fileInputRef = useRef<HTMLInputElement>(null)

  // Fetch the current user's ID so we can PATCH their password
  useEffect(() => {
    const username = localStorage.getItem("grc_username") || sessionStorage.getItem("grc_username")
    const token = localStorage.getItem("grc_token") || sessionStorage.getItem("grc_token")

    if (username && token) {
      fetch("/api/users/", {
        headers: { "Authorization": `Token ${token}` }
      })
        .then(res => res.json())
        .then(data => {
          if (Array.isArray(data)) {
            const currentUser = data.find((u: any) => u.username === username)
            if (currentUser) {
              setUserId(String(currentUser.id))
            }
          }
        })
        .catch(err => console.error("Failed to fetch user ID:", err))
    }
  }, [])

  function handleLogoChange(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0]
    if (!file) return
    if (!file.type.startsWith("image/")) {
      toast.error("Unsupported file", { description: "Please choose an image file." })
      return
    }
    if (file.size > 5 * 1024 * 1024) {
      toast.error("File too large", { description: "Logos must be 5MB or smaller." })
      return
    }

    const reader = new FileReader()
    reader.onload = (event) => {
      const img = new Image()
      img.onload = () => {
        const canvas = document.createElement("canvas")
        const MAX_WIDTH = 256
        let width = img.width
        let height = img.height
        
        if (width > MAX_WIDTH) {
          height = height * (MAX_WIDTH / width)
          width = MAX_WIDTH
        }
        
        canvas.width = width
        canvas.height = height
        
        const ctx = canvas.getContext("2d")
        ctx?.drawImage(img, 0, 0, width, height)
        
        const compressedDataUrl = canvas.toDataURL("image/jpeg", 0.8)
        setLogoDataUrl(compressedDataUrl)
      }
      img.src = event.target?.result as string
    }
    reader.readAsDataURL(file)
  }

  async function handleNextStep() {
    if (step === 1) {
      if (newPassword.length < 8) {
        toast.error("Invalid Password", { description: "Password must be at least 8 characters long." })
        return
      }
      if (newPassword !== confirmPassword) {
        toast.error("Passwords Mismatch", { description: "The new password fields do not match." })
        return
      }
      
      setIsUpdatingPassword(true)
      const token = localStorage.getItem("grc_token") || sessionStorage.getItem("grc_token")
      
      try {
        const response = await fetch(`/api/users/${userId}/`, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Token ${token}`
          },
          body: JSON.stringify({ password: newPassword }),
        })

        if (response.ok) {
          toast.success("Appliance Secured")
          setStep(2)
        } else {
          toast.error("Failed to update password")
        }
      } catch (error) {
        toast.error("Network Error", { description: "Could not connect to the appliance backend." })
      } finally {
        setIsUpdatingPassword(false)
      }
    } else if (step === 2) {
      if (!companyName.trim()) {
        toast.error("Company Name Required")
        return
      }
      updateOrganization({
        companyName: companyName.trim(),
        workspaceName: workspaceName.trim(),
        logoDataUrl,
      })
      setStep(3)
    } else if (step === 3) {
      setStep(4)
    }
  }

  return (
    <div className="min-h-screen w-full bg-muted/40 flex flex-col items-center justify-center p-4 sm:p-8">
      
      <div className="w-full max-w-2xl flex items-center justify-center mb-8 gap-3">
        <div className="flex size-10 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm">
          <ShieldCheck className="size-6" aria-hidden />
        </div>
        <div>
          <h1 className="text-xl font-bold tracking-tight">ByteTex Appliance Setup</h1>
          <p className="text-sm text-muted-foreground font-medium">Out-of-the-box Configuration</p>
        </div>
      </div>

      <div className="w-full max-w-2xl mb-6">
        <div className="flex items-center justify-between relative">
          <div className="absolute left-0 top-1/2 -translate-y-1/2 w-full h-1 bg-border rounded-full" />
          <div className="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-primary rounded-full transition-all duration-500" style={{ width: step === 1 ? '0%' : step === 2 ? '33%' : step === 3 ? '66%' : '100%' }} />
          
          {[1, 2, 3, 4].map((num) => (
            <div key={num} className={`relative z-10 flex flex-col items-center justify-center gap-2 transition-all duration-300 ${step >= num ? 'text-primary' : 'text-muted-foreground'}`}>
              <div className={`size-8 rounded-full flex items-center justify-center text-sm font-bold border-2 bg-background transition-colors ${step >= num ? 'border-primary text-primary' : 'border-border text-muted-foreground'}`}>
                {step > num ? <CheckCircle2 className="size-5 text-primary" /> : num}
              </div>
            </div>
          ))}
        </div>
        <div className="flex justify-between mt-2 text-xs font-semibold px-1 text-muted-foreground">
          <span className={step >= 1 ? 'text-foreground' : ''}>Security</span>
          <span className={step >= 2 ? 'text-foreground' : ''}>Branding</span>
          <span className={step >= 3 ? 'text-foreground' : ''}>Framework</span>
          <span className={step >= 4 ? 'text-foreground' : ''}>Complete</span>
        </div>
      </div>

      <Card className="w-full max-w-2xl shadow-lg border-border/60">
        
        {step === 1 && (
          <>
            <CardHeader className="text-center pb-8 pt-8">
              <div className="mx-auto flex size-14 items-center justify-center rounded-full bg-amber-500/10 text-amber-500 mb-4">
                <LockKeyhole className="size-7" />
              </div>
              <CardTitle className="text-2xl">Secure Your Appliance</CardTitle>
              <CardDescription className="text-base mt-2">
                You are currently using the factory default credentials. Please change the master password to secure the appliance before continuing.
              </CardDescription>
            </CardHeader>
            <CardContent className="grid gap-6 px-8 sm:px-16">
              <div className="grid gap-2">
                <Label htmlFor="new-password">New Master Password</Label>
                <Input 
                  id="new-password" 
                  type="password" 
                  value={newPassword} 
                  onChange={(e) => setNewPassword(e.target.value)} 
                  placeholder="At least 8 characters"
                  className="h-10"
                />
              </div>
              <div className="grid gap-2">
                <Label htmlFor="confirm-password">Confirm Password</Label>
                <Input 
                  id="confirm-password" 
                  type="password" 
                  value={confirmPassword} 
                  onChange={(e) => setConfirmPassword(e.target.value)} 
                  placeholder="Type password again"
                  className="h-10"
                />
              </div>
            </CardContent>
            <CardFooter className="px-8 pb-8 pt-4 flex justify-end border-t border-border mt-4 bg-muted/20 rounded-b-xl">
              <Button size="lg" onClick={handleNextStep} disabled={isUpdatingPassword || !newPassword || !confirmPassword || !userId}>
                {isUpdatingPassword ? "Securing Appliance..." : "Save & Continue"} <ArrowRight className="ml-2 size-4" />
              </Button>
            </CardFooter>
          </>
        )}

        {step === 2 && (
          <>
            <CardHeader className="text-center pb-8 pt-8">
              <CardTitle className="text-2xl">Welcome to your GRC Workspace</CardTitle>
              <CardDescription className="text-base mt-2">Let&apos;s brand this appliance for your organization.</CardDescription>
            </CardHeader>
            <CardContent className="grid gap-8 px-8">
              <div className="flex flex-col gap-4 sm:flex-row sm:items-center">
                <div className="flex size-20 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-border bg-muted shadow-inner">
                  {logoDataUrl ? (
                    // eslint-disable-next-line @next/next/no-img-element
                    <img src={logoDataUrl} alt="Company logo" className="size-full object-cover" />
                  ) : (
                    <Building2 className="size-8 text-muted-foreground/50" aria-hidden />
                  )}
                </div>
                <div className="flex flex-col gap-2">
                  <div className="flex flex-wrap gap-2">
                    <Button type="button" variant="outline" size="sm" className="gap-2" onClick={() => fileInputRef.current?.click()}>
                      <Upload className="size-4" aria-hidden />
                      Upload Company Logo
                    </Button>
                    {logoDataUrl && (
                      <Button type="button" variant="ghost" size="sm" onClick={() => setLogoDataUrl(null)}>Remove</Button>
                    )}
                  </div>
                  <p className="text-xs text-muted-foreground">Square PNG or SVG recommended. Max 5MB.</p>
                  <input ref={fileInputRef} type="file" accept="image/*" className="sr-only" onChange={handleLogoChange} />
                </div>
              </div>

              <div className="grid gap-5">
                <div className="grid gap-2">
                  <Label htmlFor="company-name" className="text-sm font-semibold">Legal Company Name *</Label>
                  <Input id="company-name" value={companyName} onChange={(e) => setCompanyName(e.target.value)} placeholder="e.g. Acme Corporation" className="h-10" />
                </div>
                <div className="grid gap-2">
                  <Label htmlFor="workspace-name" className="text-sm font-semibold">Workspace Title</Label>
                  <Input id="workspace-name" value={workspaceName} onChange={(e) => setWorkspaceName(e.target.value)} placeholder="e.g. Compliance Solutions" className="h-10" />
                  <p className="text-xs text-muted-foreground">This title appears beneath your logo in the navigation menu.</p>
                </div>
              </div>
            </CardContent>
            <CardFooter className="px-8 pb-8 pt-4 flex justify-end border-t border-border mt-4 bg-muted/20 rounded-b-xl">
              <Button size="lg" onClick={handleNextStep} disabled={!companyName.trim()}>
                Continue <ArrowRight className="ml-2 size-4" />
              </Button>
            </CardFooter>
          </>
        )}

        {step === 3 && (
          <>
            <CardHeader className="text-center pb-6 pt-8">
              <CardTitle className="text-2xl">Seed your First Framework</CardTitle>
              <CardDescription className="text-base mt-2">Upload a structured JSON file containing your baseline controls (e.g. SOC 2, PCI-DSS).</CardDescription>
            </CardHeader>
            <CardContent className="px-8 pb-8">
              <FrameworkUploader onImported={() => setTimeout(() => setStep(4), 2000)} />
            </CardContent>
            <CardFooter className="px-8 py-4 flex justify-between border-t border-border bg-muted/20 rounded-b-xl">
              <Button variant="ghost" onClick={() => setStep(2)}>Back</Button>
              <Button variant="outline" onClick={handleNextStep}>Skip for now <ChevronRight className="ml-1 size-4" /></Button>
            </CardFooter>
          </>
        )}

        {step === 4 && (
          <div className="flex flex-col items-center justify-center py-16 px-8 text-center animate-in fade-in zoom-in duration-500">
            <div className="size-20 bg-success/15 text-success rounded-full flex items-center justify-center mb-6 ring-8 ring-success/5">
              <CheckCircle2 className="size-10" />
            </div>
            <h2 className="text-3xl font-bold tracking-tight mb-3">Appliance Ready</h2>
            <p className="text-muted-foreground max-w-md text-base mb-8">
              Your identity management is secure, your branding is set, and your database is initialized. 
            </p>
            <Button size="lg" onClick={onComplete} className="w-full sm:w-auto min-w-[200px] h-12 text-base shadow-lg">
              Enter Dashboard <ArrowRight className="ml-2 size-5" />
            </Button>
          </div>
        )}
      </Card>
    </div>
  )
}
</file>

<file path="grc-frontend/components/poam-tab.tsx">
"use client"

import { useEffect, useState } from "react"
import { Check, Trash2 } from "lucide-react"
import { Button } from "@/components/ui/button"
import { Label } from "@/components/ui/label"
import { Textarea } from "@/components/ui/textarea"
import { Input } from "@/components/ui/input"
import { Badge } from "@/components/ui/badge"
import { toast } from "sonner"
import { fetchApi } from "@/lib/api"
import { type ComplianceControl, type RemediationTask } from "@/lib/controls"

interface PoamTabProps {
  control: ComplianceControl
  role: string | null
}

export function PoamTab({ control, role }: PoamTabProps) {
  const isAdmin = role === "Admin"
  const isAuditor = role === "Auditor"
  const isExecutive = role === "Executive"

  const [tasks, setTasks] = useState<RemediationTask[]>([])
  const [newTaskTitle, setNewTaskTitle] = useState("")
  const [newTaskDesc, setNewTaskDesc] = useState("")
  const [isTaskSubmitting, setIsTaskSubmitting] = useState(false)

  useEffect(() => {
    setTasks(control.remediation_tasks ?? [])
    setNewTaskTitle("")
    setNewTaskDesc("")
  }, [control])

  async function handleCreateTask(e: React.FormEvent) {
    e.preventDefault()
    if (!newTaskTitle.trim()) return
    setIsTaskSubmitting(true)
    
    try {
      const res = await fetchApi("tasks/", {
        method: "POST",
        body: JSON.stringify({
          control: control.id,
          title: newTaskTitle,
          description: newTaskDesc,
          status: "Open"
        })
      })
      if (res.ok) {
        const newTask = await res.json()
        setTasks([newTask, ...tasks])
        setNewTaskTitle("")
        setNewTaskDesc("")
        toast.success("Task added to POA&M")
      } else {
        toast.error("Failed to create task")
      }
    } catch (err) {
      toast.error("Network error while creating task.")
    } finally {
      setIsTaskSubmitting(false)
    }
  }

  async function handleResolveTask(taskId: number) {
    try {
      const res = await fetchApi(`tasks/${taskId}/`, {
        method: "PATCH",
        body: JSON.stringify({ status: "Resolved" })
      })
      if (res.ok) {
        setTasks(tasks.map(t => t.id === taskId ? { ...t, status: "Resolved" } : t))
        toast.success("Task resolved")
      } else {
        toast.error("Failed to update task status.")
      }
    } catch (err) {
      toast.error("Network error while resolving task.")
    }
  }

  async function handleDeleteTask(taskId: number) {
    try {
      const res = await fetchApi(`tasks/${taskId}/`, {
        method: "DELETE",
      })
      if (res.ok) {
        setTasks(tasks.filter(t => t.id !== taskId))
        toast.success("Task deleted")
      } else {
        toast.error("Failed to delete task")
      }
    } catch (err) {
      toast.error("Network error while deleting task.")
    }
  }

  return (
    <div className="flex flex-col gap-6 outline-none">
      <div className="flex flex-col gap-4">
        {tasks.length === 0 ? (
          <div className="py-10 text-center bg-card border border-border rounded-lg border-dashed">
            <p className="text-sm text-muted-foreground">No remediation tasks currently mapped.</p>
          </div>
        ) : (
          <ul className="grid gap-3">
            {tasks.map(task => (
              <li key={task.id} className="p-4 border border-border rounded-lg bg-card shadow-sm flex flex-col gap-2">
                <div className="flex justify-between items-start gap-2">
                  <h4 className="font-semibold text-sm leading-tight text-foreground">{task.title}</h4>
                  <Badge variant="outline" className={task.status === 'Resolved' ? 'bg-success/15 text-success' : 'bg-amber-500/15 text-amber-500'}>
                    {task.status}
                  </Badge>
                </div>
                {task.description && (
                  <p className="text-xs text-muted-foreground text-pretty">{task.description}</p>
                )}
                <div className="flex items-center justify-between mt-2 pt-2 border-t border-border/50">
                   <span className="text-[10px] text-muted-foreground">
                     Requested by <span className="font-medium text-foreground">{task.requested_by_username || "System"}</span> on {new Date(task.created_at).toLocaleDateString()}
                   </span>
                   <div className="flex gap-2">
                     {isAdmin && (
                       <Button variant="ghost" size="xs" onClick={() => handleDeleteTask(task.id)} className="h-7 text-[11px] text-destructive hover:bg-destructive/10 hover:text-destructive">
                         <Trash2 className="size-3 mr-1.5" />
                         Delete
                       </Button>
                     )}
                     {task.status !== "Resolved" && !isAuditor && !isExecutive && (
                       <Button variant="secondary" size="xs" onClick={() => handleResolveTask(task.id)} className="h-7 text-[11px] gap-1.5">
                         <Check className="size-3" />
                         Mark Resolved
                       </Button>
                     )}
                   </div>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>

      {!isAuditor && !isExecutive && (
        <div className="rounded-lg border border-border bg-card shadow-sm p-4">
          <h4 className="text-sm font-semibold mb-3">Add Remediation Task</h4>
          <form onSubmit={handleCreateTask} className="grid gap-3">
            <div className="grid gap-1.5">
              <Label htmlFor="task-title" className="text-xs">Task Objective</Label>
              <Input 
                id="task-title"
                placeholder="e.g. Implement MFA on DB" 
                value={newTaskTitle} 
                onChange={e => setNewTaskTitle(e.target.value)} 
                disabled={isTaskSubmitting}
              />
            </div>
            <div className="grid gap-1.5">
              <Label htmlFor="task-desc" className="text-xs">Technical Details</Label>
              <Textarea 
                id="task-desc"
                placeholder="Describe the steps, scripts, or policy updates required to fix this weakness..." 
                value={newTaskDesc} 
                onChange={e => setNewTaskDesc(e.target.value)} 
                rows={3} 
                className="resize-none" 
                disabled={isTaskSubmitting}
              />
            </div>
            <Button type="submit" disabled={!newTaskTitle.trim() || isTaskSubmitting} className="w-full sm:w-auto sm:justify-self-end mt-1">
              {isTaskSubmitting ? "Creating..." : "Create Task"}
            </Button>
          </form>
        </div>
      )}
    </div>
  )
}
