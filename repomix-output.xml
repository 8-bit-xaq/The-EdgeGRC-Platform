        heatmap_data = [["Likelihood \\ Impact", "1", "2", "3", "4", "5"]]
        heatmap_style = [
            ('ALIGN', (0,0), (-1,-1), 'CENTER'),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
