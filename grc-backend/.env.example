# ==========================================
# Edge-GRC Backend - Environment Example
# ==========================================

# Production: False | Development: True
DJANGO_DEBUG=False

# Optional: Custom CORS & CSRF Origins (comma-separated)
# DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.1.50:3000,http://edge-grc.local:3000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://edge-grc.local,http://192.168.1.50

# ==========================================
# Pluggable Database Configuration
# ==========================================
# Default is 'sqlite'. To switch to PostgreSQL, set DB_ENGINE=postgres:
# DB_ENGINE=postgres
# POSTGRES_DB=edgegrc
# POSTGRES_USER=edgegrc_user
# POSTGRES_PASSWORD=YourSecurePassword123!
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer
#
# Alternatively, provide a unified connection URL:
# DATABASE_URL=postgresql://edgegrc_user:YourSecurePassword123!@127.0.0.1:5432/edgegrc
