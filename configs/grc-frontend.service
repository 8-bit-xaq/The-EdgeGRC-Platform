[Unit]
Description=GRC Frontend Next.js Node Server
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/grc-appliance/grc-frontend
Environment="NODE_ENV=production"
Environment="PORT=3000"
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target