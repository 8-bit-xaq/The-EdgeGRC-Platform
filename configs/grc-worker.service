[Unit]
Description=GRC Django Q Background Worker
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/grc-appliance/grc-backend
Environment="PATH=/opt/grc-appliance/grc-backend/venv/bin"
EnvironmentFile=-/opt/grc-appliance/grc-backend/configs/db.env
ExecStart=/opt/grc-appliance/grc-backend/venv/bin/python manage.py qcluster
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
