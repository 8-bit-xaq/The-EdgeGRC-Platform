/opt/grc-appliance/grc-backend/logs/*.log {
    weekly
    missingok
    rotate 12
    compress
    delaycompress
    notifempty
    create 0640 www-data www-data
    sharedscripts
    postrotate
        systemctl reload grc-backend > /dev/null 2>&1 || true
    endscript
}

/opt/grc-appliance/backups/*.zip {
    daily
    missingok
    rotate 14
    notifempty
}

